---
import AdminLayout from '../../layouts/AdminLayout.astro';
if (Astro.locals.cmsUser) return Astro.redirect('/admin');
const error = Astro.url.searchParams.get('error');
const recovery = Astro.url.searchParams.get('recovery');
const reset = Astro.url.searchParams.get('reset');
---
<AdminLayout title="Owner sign in" description="Protected access for portfolio publishing.">
  <div class="admin-content login-wrap">
    {!Astro.locals.cmsConfigured ? <div class="notice"><strong>Connect Supabase first.</strong><br />Copy <code>.env.example</code> to <code>.env</code>, add the project URL and publishable key, then run the included SQL migration.</div> :
    <form class="panel login" method="post" action="/api/admin/login">
      {error === 'credentials' && <p class="error">The email or password was not accepted.</p>}
      {error === 'recovery' && <p class="error">That recovery link is invalid or has expired. Request a new one below.</p>}
      {recovery === 'sent' && <p class="success">Recovery email sent. Open its newest link in this browser.</p>}
      {reset === 'success' && <p class="success">Password updated. Sign in with your new password.</p>}
      <div class="field"><label for="email">EMAIL</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
      <div class="field"><label for="password">PASSWORD</label><input id="password" name="password" type="password" autocomplete="current-password" required /></div>
      <button class="admin-button primary" type="submit">Enter CMS</button>
    </form>
    <form class="panel recovery" method="post" action="/api/admin/password-recovery">
      <div><strong>Forgot your password?</strong><p>Enter the CMS account email and Supabase will send a secure reset link.</p></div>
      <div class="field"><label for="recovery-email">ACCOUNT EMAIL</label><input id="recovery-email" name="email" type="email" autocomplete="email" required /></div>
      <button class="admin-button" type="submit">Send recovery link</button>
    </form>}
  </div>
</AdminLayout>
<style>.login-wrap{max-width:620px;display:grid;gap:18px}.login,.recovery{display:grid;gap:18px}.recovery{margin-top:4px}.recovery strong{font:500 18px Space Grotesk}.recovery p{margin:.25rem 0 0;color:var(--muted)}.error,.success{margin:0}.error{color:#ff9b9b}.success{color:var(--accent)}</style>

