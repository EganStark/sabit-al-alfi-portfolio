---
import AdminLayout from '../../layouts/AdminLayout.astro';
const error = Astro.url.searchParams.get('error');
---
<AdminLayout title="Set a new password" description="Choose a new password for the portfolio CMS owner account.">
  <div class="admin-content reset-wrap">
    <form class="panel reset-form" method="post" action="/api/admin/reset-password">
      {error && <p class="error">The password could not be updated. Use at least eight characters and try again.</p>}
      <div class="field"><label for="password">NEW PASSWORD</label><input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required /></div>
      <div class="field"><label for="confirmation">CONFIRM NEW PASSWORD</label><input id="confirmation" name="confirmation" type="password" minlength="8" autocomplete="new-password" required /></div>
      <button class="admin-button primary" type="submit">Update password</button>
    </form>
  </div>
</AdminLayout>
<style>.reset-wrap{max-width:620px}.reset-form{display:grid;gap:18px}.error{margin:0;color:#ff9b9b}</style>
